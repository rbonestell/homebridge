# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Match single quotes for JS/TS (as per 'quotes' rule)
quote_type = single

# Markdown files (don't trim trailing whitespace)
[*.md]
trim_trailing_whitespace = false

# JSON files (indent with 2 spaces)
[*.json]
indent_style = space
indent_size = 2

# YAML files (indent with 2 spaces)
[*.yml]
indent_style = space
indent_size = 2
